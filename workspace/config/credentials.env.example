# MarketClaw - Platform Credentials
# Copy this file to .env and fill in your API keys

# === Korean Platforms ===

# Naver Blog (Browser Automation - API shut down May 2020)
NAVER_USERNAME=
NAVER_PASSWORD=
NAVER_BLOG_ID=          # Optional: your blog ID (from blog.naver.com/YOUR_ID)

# Tistory (Browser Automation - no API since Feb 2024)
TISTORY_USERNAME=
TISTORY_PASSWORD=
TISTORY_BLOG_NAME=

# Velog (Browser Automation - no official API)
VELOG_USERNAME=
VELOG_PASSWORD=

# === English Platforms ===

# Medium (REST API)
# Generate at Settings > Security and apps > Integration tokens
MEDIUM_INTEGRATION_TOKEN=

# WordPress (REST API)
# Generate App Password at wp-admin > Users > Edit > Application Passwords
WP_SITE_URL=https://yourblog.com
WP_USERNAME=
WP_APP_PASSWORD=

# Dev.to (REST API)
# Get at https://dev.to/settings/extensions
DEVTO_API_KEY=

# Hashnode (GraphQL API)
# Get at https://hashnode.com/settings/developer
HASHNODE_PAT=
HASHNODE_PUBLICATION_ID=

# === Image Services ===

# Unsplash (free stock photos)
# Get at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Pexels (free stock photos)
# Get at https://www.pexels.com/api/
PEXELS_API_KEY=

# OpenAI (for DALL-E 3 image generation)
OPENAI_API_KEY=
