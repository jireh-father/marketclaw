{
  "platforms": {
    "naver": {
      "enabled": true,
      "language": "ko",
      "method": "browser",
      "script": "scripts/publish/naver.sh",
      "credentials_env": "NAVER_USERNAME",
      "credentials_password_env": "NAVER_PASSWORD",
      "credentials_blog_id_env": "NAVER_BLOG_ID",
      "auto_publish": true,
      "login_url": "https://nid.naver.com/nidlogin.login",
      "notes": "Blog writePost API shut down May 2020. Uses Playwright MCP browser automation. 로그인 시 환경변수의 아이디/비밀번호를 브라우저 로그인 폼에 직접 입력한다."
    },
    "tistory": {
      "enabled": false,
      "language": "ko",
      "method": "browser",
      "script": "scripts/publish/tistory.sh",
      "credentials_env": "TISTORY_USERNAME",
      "credentials_password_env": "TISTORY_PASSWORD",
      "credentials_blog_name_env": "TISTORY_BLOG_NAME",
      "auto_publish": true,
      "daily_limit": 5,
      "login_url": "https://www.tistory.com/auth/login",
      "notes": "API shut down Feb 2024. Uses Playwright MCP browser automation. 카카오 계정으로 로그인. 환경변수의 아이디/비밀번호를 브라우저에 직접 입력한다."
    },
    "medium": {
      "enabled": false,
      "language": "en",
      "method": "api",
      "script": "scripts/publish/medium.sh",
      "credentials_env": "MEDIUM_INTEGRATION_TOKEN",
      "auto_publish": false,
      "default_status": "draft",
      "notes": "API deprecated but functional. Create-only (no update/delete)."
    },
    "wordpress": {
      "enabled": false,
      "language": "en",
      "method": "api",
      "script": "scripts/publish/wordpress.sh",
      "credentials_env": "WP_APP_PASSWORD",
      "auto_publish": true,
      "notes": "Full CRUD via WP REST API. Requires Application Password."
    },
    "devto": {
      "enabled": false,
      "language": "en",
      "method": "api",
      "script": "scripts/publish/devto.sh",
      "credentials_env": "DEVTO_API_KEY",
      "auto_publish": false,
      "default_status": "draft",
      "rate_limit": "10 req/30s",
      "notes": "Forem API. Markdown only. Supports create + update."
    },
    "hashnode": {
      "enabled": false,
      "language": "en",
      "method": "api",
      "script": "scripts/publish/hashnode.js",
      "credentials_env": "HASHNODE_PAT",
      "auto_publish": true,
      "notes": "GraphQL API. Full CRUD. 500 mutations/min."
    },
    "velog": {
      "enabled": false,
      "language": "ko",
      "method": "browser",
      "script": "scripts/publish/velog.sh",
      "credentials_env": "VELOG_USERNAME",
      "credentials_password_env": "VELOG_PASSWORD",
      "auto_publish": true,
      "login_url": "https://velog.io",
      "notes": "No official API. Uses Playwright MCP browser automation. 환경변수의 아이디/비밀번호를 브라우저 로그인 폼에 직접 입력한다."
    }
  }
}
